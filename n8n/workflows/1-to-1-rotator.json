      "name": "Fetch Table"
    },
    {
      "parameters": {
        "jsCode": "const employees = $input.first().json.data.items;\n\nconst people = employees.map(emp => ({\n  name: emp.fields.Name,\n  recordId: emp.record_id,\n  history: emp.fields[\"Partner History\"] || \"\",\n  userId: emp.fields[\"User ID\"] || \"\"\n}));\n\nfunction shuffle(array) {\n  for (let i = array.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [array[i], array[j]] = [array[j], array[i]];\n  }\n  return array;\n}\n\nconst shuffled = shuffle([...people]);\nconst pairs = [];\n\nfor (let i = 0; i < shuffled.length; i += 2) {\n  pairs.push({\n    person1: shuffled[i],\n    person2: shuffled[i + 1]\n  });\n}\n\nconst updates = [];\nfor (const pair of pairs) {\n  updates.push({\n    recordId: pair.person1.recordId,\n    name: pair.person1.name,\n    partner: pair.person2.name,\n    newHistory: pair.person1.history ? pair.person1.history + \", \" + pair.person2.name : pair.person2.name,\n    userId: pair.person1.userId\n  });\n  updates.push({\n    recordId: pair.person2.recordId,\n    name: pair.person2.name,\n    partner: pair.person1.name,\n    newHistory: pair.person2.history ? pair.person2.history + \", \" + pair.person1.name : pair.person1.name,\n    userId: pair.person2.userId\n  });\n}\n\nreturn updates.map(u => ({ json: u }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
