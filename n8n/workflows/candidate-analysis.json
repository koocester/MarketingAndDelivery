    {
      "parameters": {
        "jsCode": "// Re-attach Binary: pass through the form submission item AS-IS (with its binary)\n// but enrich its json with the candidate folder data.\n\nconst folderItem = $input.first();\nconst formItem = $('On form submission').first();\n\n// Guard: form submission must have binary\nif (!formItem || !formItem.binary || Object.keys(formItem.binary).length === 0) {\n  throw new Error('On form submission item has no binary attached. Check the form node ran and produced a file.');\n}\n\n// Normalize MIME for text-based extensions Drive labels octet-stream\nconst sourceKey = Object.keys(formItem.binary)[0];\nconst sourceBin = formItem.binary[sourceKey];\nconst fileName = (sourceBin.fileName || '').toLowerCase();\nconst textExts = ['.srt', '.vtt', '.txt', '.md', '.log', '.csv', '.json', '.xml', '.html'];\nlet normalizedMime = sourceBin.mimeType || 'application/octet-stream';\nif (textExts.some(ext => fileName.endsWith(ext))) normalizedMime = 'text/plain';\n\nsourceBin.mimeType = normalizedMime;\n\n// Rename binary key to 'transcript' if it isn't already\nif (sourceKey !== 'transcript') {\n  formItem.binary['transcript'] = sourceBin;\n  delete formItem.binary[sourceKey];\n}\n\n// Merge folder json data on top of the form item's json (guarded)\nconst folderJson = (folderItem && folderItem.json) ? folderItem.json : (folderItem || {});\nconst formJson = formItem.json || {};\n\nreturn [{\n  json: { ...formJson, ...folderJson },\n  binary: formItem.binary\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1712, 32],
