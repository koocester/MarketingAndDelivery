    {
      "parameters": {
        "jsCode": "function normalize(post, platform, account) {\n  const contentRaw = post.content || post.message || post.videoDescription || post.description || post.title || post.story || '';\n  const firstLine = contentRaw.split('\\n')[0].trim().substring(0, 200);\n  let url = post.url || post.reelUrl || post.shareUrl || post.link || post.permalink_url || '';\n  if (!url && platform === 'Facebook' && post.reelId) url = 'https://www.facebook.com/reel/' + post.reelId;\n  let publishedDateStr = '';\n  if (post.publishedAt?.dateTime) publishedDateStr = post.publishedAt.dateTime;\n  else if (post.created?.dateTime) publishedDateStr = post.created.dateTime;\n  else if (typeof post.createTime === 'string') publishedDateStr = post.createTime;\n  return {\n    url, account, platform, type: post.type || 'REEL',\n    videoTitle: firstLine, caption: firstLine, publishedDateStr,\n    views:        post.blueReelsPlayCount ?? post.views ?? post.viewCount ?? post.plays ?? 0,\n    reach:        post.postImpressionsUnique ?? post.reach ?? 0,\n    impressions:  post.postImpressionsUnique ?? post.impressionsTotal ?? post.impressions ?? 0,\n    likes:        post.postVideoReactions ?? post.likes ?? post.likeCount ?? post.reactions ?? 0,\n    comments:     post.comments ?? post.commentCount ?? 0,\n    shares:       post.shares ?? post.postVideoSocialActions ?? post.reposts ?? post.shareCount ?? 0,\n    saved:        post.saved ?? post.saves ?? 0,\n    interactions: post.interactions ?? post.postVideoSocialActions ?? 0,\n    engagement:   post.engagement ?? 0\n  };\n}\n\nconst combos = [{\"node\": \"IG Wealth\", \"account\": \"Wealth\", \"platform\": \"Instagram\", \"filterVideo\": false}, {\"node\": \"FB Wealth\", \"account\": \"Wealth\", \"platform\": \"Facebook\", \"filterVideo\": false}, {\"node\": \"TT Wealth\", \"account\": \"Wealth\", \"platform\": \"TikTok\", \"filterVideo\": true}, {\"node\": \"IG Autos\", \"account\": \"Autos\", \"platform\": \"Instagram\", \"filterVideo\": false}, {\"node\": \"FB Autos\", \"account\": \"Autos\", \"platform\": \"Facebook\", \"filterVideo\": false}, {\"node\": \"TT Autos\", \"account\": \"Autos\", \"platform\": \"TikTok\", \"filterVideo\": true}, {\"node\": \"IG Homes\", \"account\": \"Homes\", \"platform\": \"Instagram\", \"filterVideo\": false}, {\"node\": \"FB Homes\", \"account\": \"Homes\", \"platform\": \"Facebook\", \"filterVideo\": false}, {\"node\": \"TT Homes\", \"account\": \"Homes\", \"platform\": \"TikTok\", \"filterVideo\": true}, {\"node\": \"IG Foodie\", \"account\": \"Foodie\", \"platform\": \"Instagram\", \"filterVideo\": false}, {\"node\": \"FB Foodie\", \"account\": \"Foodie\", \"platform\": \"Facebook\", \"filterVideo\": false}, {\"node\": \"TT Foodie\", \"account\": \"Foodie\", \"platform\": \"TikTok\", \"filterVideo\": true}, {\"node\": \"IG Business\", \"account\": \"Business\", \"platform\": \"Instagram\", \"filterVideo\": false}, {\"node\": \"FB Business\", \"account\": \"Business\", \"platform\": \"Facebook\", \"filterVideo\": false}, {\"node\": \"TT Business\", \"account\": \"Business\", \"platform\": \"TikTok\", \"filterVideo\": true}];\nconst larkToken = $('Get Lark Token').first().json.tenant_access_token;\nconst allPosts = [];\n\nfor (const combo of combos) {\n  const raw = $(combo.node).first().json;\n  const data = Array.isArray(raw) ? (raw[0]?.data || []) : (raw.data || []);\n  const posts = data\n    .filter(p => !combo.filterVideo || p.type === 'VIDEO')\n    .map(p => normalize(p, combo.platform, combo.account));\n  allPosts.push(...posts);\n  console.log(combo.account + ' ' + combo.platform + ': ' + posts.length);\n}\n\nconsole.log('Total: ' + allPosts.length);\nreturn [{ json: { data: allPosts, total: allPosts.length, larkToken: larkToken } }];"
      },
