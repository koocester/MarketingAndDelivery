      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS content_perf.reels (post_url text PRIMARY KEY, page text, country text, platform text, published_date date, video_title text, views bigint, reach bigint, impressions bigint, likes bigint, comments bigint, shares bigint, saves bigint, interactions bigint, engagement_rate double precision, loaded_at timestamptz default now());",
        "options": {}
