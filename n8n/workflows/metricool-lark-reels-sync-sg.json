    {
      "parameters": {
        "url": "https://open.larksuite.com/open-apis/bitable/v1/apps/Yp6cwMAtZiOYEjkQzRAlmqWJgQd/tables/tblTkWga52OsXod7/records",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "page_size", "value": "500" } ] },
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $('Combine All Reels').first().json.larkToken }}" } ] },
        "options": {}
      },
      "id": "df47ccf8-2403-44b8-b69e-d05cd371eed8",
      "name": "Get Lark Records",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-2304, 16]
    },
    {
      "parameters": {
        "jsCode": "const allPosts = $('Combine All Reels').first().json.data || [];\nconst larkItems = $input.item.json.data?.items || [];\nconst toCreate = [], toUpdate = [];\n\nfor (const post of allPosts) {\n  const postUrl = (post.url || '').trim().replace(/\\/$/,'');\n  const publishedDate = post.publishedDateStr ? post.publishedDateStr.split('T')[0] : null;\n  const matched = larkItems.find(r => {\n    const stored = r.fields?.['Post URL'];\n    if (!stored) return false;\n    return stored.trim().replace(/\\/$/,'') === postUrl;\n  });\n  const fields = {\n    'Post URL': post.url, 'Account': post.account, 'Platform': post.platform,\n    'Video Title': post.videoTitle, 'Caption': post.caption,\n    'Views': post.views, 'Reach': post.reach, 'Impressions': post.impressions,\n    'Likes': post.likes, 'Comments': post.comments, 'Shares': post.shares,\n    'Saves': post.saved, 'Interactions': post.interactions,\n    'Engagement Rate': parseFloat(post.engagement.toFixed(4))\n  };\n  if (publishedDate) fields['Published Date'] = publishedDate;\n  if (matched) toUpdate.push({ record_id: matched.record_id, fields });\n  else toCreate.push({ fields });\n}\n\nfunction chunk(arr, size) {\n  const chunks = [];\n  for (let i = 0; i < arr.length; i += size) chunks.push(arr.slice(i, i + size));\n  return chunks;\n}\n\nconst results = [];\nfor (const batch of chunk(toCreate, 500)) {\n  results.push({ json: { operation: 'create', count: batch.length, records: batch } });\n}\nfor (const batch of chunk(toUpdate, 500)) {\n  results.push({ json: { operation: 'update', count: batch.length, records: batch } });\n}\nif (results.length === 0) results.push({ json: { operation: 'skip', count: 0, records: [] } });\nconsole.log('Create batches: ' + chunk(toCreate,500).length + ' | Update batches: ' + chunk(toUpdate,500).length);\nreturn results;"
      },
      "id": "f1574c00-2c1d-499f-affc-9b98fdb94594",
      "name": "Match and Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-2080, 16]
    },
