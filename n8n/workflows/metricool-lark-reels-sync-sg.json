    },
    {
      "id": "fa1d58ce-4c95-4b22-becf-4dd1c10c4a3e",
      "name": "Build Reels Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1632, 272],
      "parameters": {
        "jsCode": "const posts = $('Combine All Reels').first().json.data || [];\nconst COUNTRY = 'Singapore';\nconst PAGE = { 'Koocester':'Koocester', 'Homes':'Koocester Homes', 'Business':'Koocester Business', 'Autos':'Koocester Autos', 'Wealth':'Koocester Wealth', 'Foodie':'Koocester Foodie' };\nconst q = (s) => (s===null||s===undefined) ? 'NULL' : (\"'\" + String(s).replace(/'/g, \"''\") + \"'\");\nconst n = (v) => { const x = Number(v); return Number.isFinite(x) ? x : 0; };\nconst seen = new Set();\nconst rows = [];\nfor (const p of posts) {\n  const url = (p.url || '').trim();\n  if (!url) continue;\n  if (seen.has(url)) continue; seen.add(url);\n  const page = PAGE[p.account] || p.account;\n  const pub = p.publishedDateStr ? p.publishedDateStr.split('T')[0] : null;\n  const vals = [q(url), q(page), q(COUNTRY), q(p.platform), (pub ? ('DATE ' + q(pub)) : 'NULL'), q(String(p.videoTitle || '').substring(0,300)), n(p.views), n(p.reach), n(p.impressions), n(p.likes), n(p.comments), n(p.shares), n(p.saved), n(p.interactions), n(p.engagement), 'now()'];\n  rows.push('(' + vals.join(', ') + ')');\n}\nif (rows.length === 0) { return [{ json: { query: 'SELECT 1', rowCount: 0 } }]; }\nconst sql = 'INSERT INTO content_perf.reels (post_url, page, country, platform, published_date, video_title, views, reach, impressions, likes, comments, shares, saves, interactions, engagement_rate, loaded_at) VALUES ' + rows.join(', ') + ' ON CONFLICT (post_url) DO UPDATE SET page=EXCLUDED.page, country=EXCLUDED.country, platform=EXCLUDED.platform, published_date=EXCLUDED.published_date, video_title=EXCLUDED.video_title, views=EXCLUDED.views, reach=EXCLUDED.reach, impressions=EXCLUDED.impressions, likes=EXCLUDED.likes, comments=EXCLUDED.comments, shares=EXCLUDED.shares, saves=EXCLUDED.saves, interactions=EXCLUDED.interactions, engagement_rate=EXCLUDED.engagement_rate, loaded_at=now();';\nreturn [{ json: { query: sql, rowCount: rows.length } }];"
      }
    },
