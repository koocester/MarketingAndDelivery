# Copy to .env.local for local dev (vercel dev). In production, set these in
# Vercel → Project → Settings → Environment Variables. NEVER commit real values.

LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret_here
LARK_APP_TOKEN=base_app_token_from_the_base_url
LARK_TABLE_ID=tbl_or_table_id_from_the_base_url
# Optional — defaults to https://open.larksuite.com (use https://open.feishu.cn for Feishu/China)
LARK_DOMAIN=https://open.larksuite.com
