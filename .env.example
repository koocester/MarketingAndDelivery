# ────────────────────────────────────────────────────────────────────
# .env.example — placeholders ONLY. Never commit real values.
# Legend:  [CONFIRMED] found in discovered code   [NEEDS CONFIRMATION] inferred from cloud usage
# Most cloud secrets do NOT live in a local .env — they live in n8n Cloud
# credentials, Vercel project env, or the MCP config files. This file is the
# canonical NAME list so a new engineer knows what exists and where to set it.
# ────────────────────────────────────────────────────────────────────

# ─── Lark (Vercel SMM dashboard app) ────────────────  [CONFIRMED — apps/smm-carousel-dashboard]
LARK_APP_ID=<LARK_APP_ID>                 # e.g. cli_xxxxxxxx
LARK_APP_SECRET=<LARK_APP_SECRET>         # server-side only — never in frontend
LARK_APP_TOKEN=<LARK_BASE_APP_TOKEN>      # from Base URL /base/<APP_TOKEN>
LARK_TABLE_ID=<LARK_TABLE_ID>             # from Base URL ?table=<TABLE_ID>
LARK_DOMAIN=https://open.larksuite.com    # or https://open.feishu.cn

# ─── Supabase (Postgres warehouse) ──────────────────  [NEEDS CONFIRMATION — lives in n8n Postgres cred]
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_DB_HOST=<SUPABASE_POOLER_HOST>   # aws-1-ap-southeast-1 pooler
SUPABASE_DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# ─── Metabase ───────────────────────────────────────  [NEEDS CONFIRMATION]
METABASE_SITE_URL=<METABASE_SITE_URL>
METABASE_DATABASE_ID=34                    # "Koocester Group" Postgres connection
METABASE_API_KEY=<METABASE_API_KEY>        # used by the metabase MCP connector

# ─── HubSpot (via Fivetran → Supabase; MCP for reads) ─ [NEEDS CONFIRMATION]
HUBSPOT_PRIVATE_APP_TOKEN=<HUBSPOT_PRIVATE_APP_TOKEN>

# ─── Xero (via Fivetran → Supabase; MCP for reads) ──  [NEEDS CONFIRMATION]
XERO_CLIENT_ID=<XERO_CLIENT_ID>
XERO_CLIENT_SECRET=<XERO_CLIENT_SECRET>
XERO_TENANT_ID=<XERO_TENANT_ID>
XERO_REDIRECT_URI=<XERO_REDIRECT_URI>

# ─── n8n (cloud-hosted) ─────────────────────────────  [NEEDS CONFIRMATION — most managed inside n8n Cloud]
N8N_BASE_URL=https://koocester.app.n8n.cloud
N8N_WEBHOOK_URL=https://koocester.app.n8n.cloud/webhook
N8N_API_KEY=<N8N_API_KEY>                  # used by the n8n-mcp connector
# Command-dashboard Basic Auth (per role webhook) — set in n8n credentials, not here:
N8N_DASHBOARD_BASIC_AUTH_USER=<USER>
N8N_DASHBOARD_BASIC_AUTH_PASSWORD=<PASSWORD>

# ─── Metricool (n8n → content_perf) ─────────────────  [NEEDS CONFIRMATION]
METRICOOL_API_KEY=<METRICOOL_X_MC_AUTH>    # the X-Mc-Auth header value

# ─── Anthropic (n8n brief summarisation) ────────────  [NEEDS CONFIRMATION]
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>

# ─── Aspire (n8n → finance) ─────────────────────────  [NEEDS CONFIRMATION — OAuth2 in n8n]
ASPIRE_CLIENT_ID=<ASPIRE_CLIENT_ID>
ASPIRE_CLIENT_SECRET=<ASPIRE_CLIENT_SECRET>

# ─── MCP config (paths, not secrets) ────────────────
MCP_CONFIG_PATH=~/.claude.json
